# Supabase project (PRD §11.4). Both values are safe in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# Server-only. Never expose this and never use it for ordinary requests —
# it bypasses RLS (§11.4). Migrations and support tooling only.
SUPABASE_SERVICE_ROLE_KEY=
